rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function roleFromProfile() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data.get('role', '')
        : '';
    }

    function hasRole(expectedRole) {
      return signedIn() && (
        request.auth.token.get('role', '') == expectedRole ||
        roleFromProfile() == expectedRole
      );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        hasRole('admin') ||
        hasRole('super_admin')
      );
    }

    function isInspectionOfficer() {
      return hasRole('inspection_officer');
    }

    function isReceivingClerk() {
      return hasRole('receiving_clerk');
    }

    function isDenrOfficer() {
      return hasRole('denr_officer');
    }

    function isStaff() {
      return isAdmin() || isInspectionOfficer() || isReceivingClerk() ||
        isDenrOfficer() || hasRole('staff') || hasRole('menro_staff') ||
        hasRole('denr_staff') || hasRole('menro') || hasRole('denr');
    }

    function isWorkflowOwner(data) {
      return signedIn() && (
        data.get('applicantUid', '') == request.auth.uid ||
        data.get('submittedByUid', '') == request.auth.uid ||
        data.get('submittedBy', '') == request.auth.uid ||
        data.get('uid', '') == request.auth.uid
      );
    }

    function canReadWorkflow(data) {
      return isStaff() || isWorkflowOwner(data);
    }

    function isPublicAccountRole(role) {
      return role in ['citizen', 'individual', 'organization'];
    }

    function canSelfCreateUser(data, uid) {
      return signedIn() && request.auth.uid == uid &&
        data.keys().hasOnly([
          'uid', 'role', 'accountType', 'name', 'fullName', 'email',
          'phoneNumber', 'avatarUrl', 'completeAddress', 'addressDetails',
          'nameDetails', 'contactPerson', 'businessPermitNumber',
          'businessPermitUrl', 'organizationPermitUrl',
          'citizenNationalIdUrl', 'organizationDetails', 'organizationId',
          'organizationStatus', 'organizationMembershipStatus',
          'organizationRequestStatus', 'organizationRequestName',
          'activeOrganizationName', 'organizationMemberships',
          'isVerified', 'isProfilePublic', 'allowNotifications',
          'impactScore', 'badges', 'createdAt', 'joinedAt'
        ]) &&
        isPublicAccountRole(data.get('role', '')) &&
        data.get('isVerified', false) == false &&
        data.get('organizationStatus', null) in [null, 'pending'] &&
        data.get('organizationMembershipStatus', null) in [null, 'pending'] &&
        data.get('organizationMemberships', []) == [] &&
        data.get('impactScore', 0) == 0 &&
        data.get('badges', []) == [];
    }

    function safeSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'fullName', 'nameDetails', 'avatarUrl', 'phoneNumber',
        'completeAddress', 'addressDetails', 'contactPerson',
        'businessPermitNumber', 'businessPermitUrl', 'organizationPermitUrl',
        'citizenNationalIdUrl', 'organizationDetails', 'isProfilePublic',
        'allowNotifications', 'updatedAt'
      ]);
    }

    function inspectorFindingsKeys() {
      return [
        'inspectionDate', 'inspectionScenarioReason',
        'inspectionNumberOfTrees', 'inspectionLocationOfTrees',
        'inspectionActionType', 'inspectionNotes', 'seedlingsRequired'
      ];
    }

    function validInspectionStatusTransition() {
      let oldStatus = resource.data.get('status', '');
      let newStatus = request.resource.data.get('status', oldStatus);
      return (
        oldStatus in ['forwarded_to_inspection_officer', 'inspection_in_progress'] &&
        newStatus in [
          'inspection_in_progress', 'forwarded_to_denr_officer',
          'inspection_confirmed'
        ]
      ) || (
        resource.data.get('forwardedToRole', '') == 'inspection_officer' &&
        newStatus in [
          'inspection_in_progress', 'forwarded_to_denr_officer',
          'inspection_confirmed'
        ]
      ) || (
        oldStatus == 'approved_by_denr' &&
        newStatus in [
          'inspection_in_progress', 'forwarded_to_denr_officer',
          'inspection_confirmed', 'resolved'
        ]
      );
    }

    function inspectionOfficerApplicationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let statusHistoryKeys = [
        'status', 'statusHistory', 'updatedAt', 'inspectionCompletedAt',
        'forwardedToRole', 'forwardedToDenrAt', 'inspectionConfirmedAt',
        'inspectionConfirmedByRole', 'resolvedAt', 'resolvedByRole'
      ];
      let allowedKeys = statusHistoryKeys.concat(inspectorFindingsKeys());
      let findingsChanged = changed.hasAny(inspectorFindingsKeys());
      return isInspectionOfficer() &&
        changed.hasOnly(allowedKeys) &&
        validInspectionStatusTransition() &&
        (!findingsChanged || resource.data.get('status', '') == 'approved_by_denr');
    }

    function receivingClerkApplicationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('status', '');
      let newStatus = request.resource.data.get('status', oldStatus);
      return isReceivingClerk() &&
        changed.hasOnly([
          'documents', 'requirementsComplete', 'requirementsCompletedAt',
          'status', 'statusHistory', 'rejectedAt', 'rejectionReason',
          'rejectionNotes', 'forwardedToRole', 'forwardedAt', 'updatedAt'
        ]) && (!changed.hasAny(['status']) || (
          oldStatus in [
            'submitted', 'pending', 'received', 'verified', 'requirements_complete'
          ] && newStatus in [
            'requirements_complete', 'forwarded_to_inspection_officer', 'rejected'
          ]
        ));
    }

    function denrApplicationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('status', '');
      let newStatus = request.resource.data.get('status', oldStatus);
      return isDenrOfficer() &&
        changed.hasOnly([
          'status', 'statusHistory', 'approvedByDenrAt',
          'menroLguCoordinationRequired', 'denrAction',
          'forwardedToRole', 'forwardedToInspectionAt', 'rejectionReason',
          'rejectedAt', 'updatedAt'
        ]) && changed.hasAny(['status']) && oldStatus in [
          'forwarded_to_denr_officer', 'forwarded_to_denr', 'for_denr_review'
        ] && newStatus in ['approved_by_denr', 'rejected'];
    }

    function staffReportUpdate() {
      return isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusHistory', 'severity', 'urgency',
          'forwardedToRole', 'forwardedAt', 'forwardedToInspectionAt',
          'resolvedAt', 'rejectedAt', 'rejectionReason', 'inspectionNotes',
          'updatedAt'
        ]);
    }

    function inspectionCaseForwardUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isInspectionOfficer() &&
        resource.data.get('inspectorId', '') == request.auth.uid &&
        resource.data.get('status', '') == 'submitted' &&
        request.resource.data.get('status', '') == 'forwarded_to_denr_officer' &&
        request.resource.data.get('forwardedToRole', '') == 'denr_officer' &&
        request.resource.data.get('forwardedAt', null) is timestamp &&
        changed.hasOnly([
          'status', 'forwardedToRole', 'forwardedAt', 'updatedAt', 'activityHistory'
        ]);
    }

    function isApplicantMessageOwner(collectionName, applicationId) {
      let application = get(
        /databases/$(database)/documents/$(collectionName)/$(applicationId)
      ).data;
      return isWorkflowOwner(application);
    }

    function validMessage(data, collectionName, applicationId) {
      return signedIn() &&
        data.keys().hasOnly([
          'message', 'imageUrl', 'authorUid', 'authorRole', 'messageType',
          'topic', 'authorName', 'sentAt'
        ]) &&
        data.get('authorUid', '') == request.auth.uid &&
        data.get('message', '').size() <= 1000 &&
        (
          (isApplicantMessageOwner(collectionName, applicationId) &&
            data.get('authorRole', '') == 'reporter' &&
            data.get('messageType', '') == 'reporter_message') ||
          (isStaff() &&
            data.get('authorRole', '') == 'staff' &&
            data.get('messageType', '') == 'staff_reply')
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId || isAdmin() ||
        resource.data.get('isProfilePublic', false) == true
      );
      allow list: if isAdmin();
      allow create: if isAdmin() || canSelfCreateUser(request.resource.data, userId);
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId && safeSelfProfileUpdate()
      );
      allow delete: if isAdmin();

      match /likes/{feedId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['likedAt']);
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    match /applications/{applicationId} {
      allow get, list: if canReadWorkflow(resource.data);
      allow create: if signedIn() && (
        isAdmin() || (
          isWorkflowOwner(request.resource.data) &&
          request.resource.data.get('status', 'submitted') in [
            'submitted', 'pending', 'received'
          ]
        )
      );
      allow update: if isAdmin() || inspectionOfficerApplicationUpdate() ||
        receivingClerkApplicationUpdate() || denrApplicationUpdate();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if canReadWorkflow(
          get(/databases/$(database)/documents/applications/$(applicationId)).data
        );
        allow create: if validMessage(
          request.resource.data, 'applications', applicationId
        );
        allow update, delete: if false;
      }
    }

    match /tree_cutting_permits/{permitId} {
      allow get, list: if canReadWorkflow(resource.data);
      allow create: if signedIn() && (
        isAdmin() || (
          isWorkflowOwner(request.resource.data) &&
          request.resource.data.get('status', 'pending') in ['pending', 'submitted']
        )
      );
      allow update: if isAdmin() || inspectionOfficerApplicationUpdate() ||
        receivingClerkApplicationUpdate() || denrApplicationUpdate();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if canReadWorkflow(
          get(/databases/$(database)/documents/tree_cutting_permits/$(permitId)).data
        );
        allow create: if validMessage(
          request.resource.data, 'tree_cutting_permits', permitId
        );
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow get, list: if canReadWorkflow(resource.data);
      allow create: if signedIn() &&
        isWorkflowOwner(request.resource.data) &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('upvotes', 0) == 0 &&
        request.resource.data.get('commentCount', 0) == 0 &&
        request.resource.data.get('severity', 1) in [1, 2, 3, 4, 5];
      allow update: if isAdmin() || staffReportUpdate() || validReportVoteUpdate(reportId);
      allow delete: if isAdmin();

      match /upvotes/{userId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['upvotedAt']) &&
          !exists(/databases/$(database)/documents/reports/$(reportId)/upvotes/$(userId));
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /messages/{messageId} {
        allow get, list: if canReadWorkflow(
          get(/databases/$(database)/documents/reports/$(reportId)).data
        );
        allow create: if validMessage(
          request.resource.data, 'reports', reportId
        );
        allow update, delete: if false;
      }
    }

    function validReportVoteUpdate(reportId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let currentVotes = resource.data.get('upvotes', 0);
      let newVotes = request.resource.data.get('upvotes', 0);
      let votePath = /databases/$(database)/documents/reports/$(reportId)/upvotes/$(request.auth.uid);
      return signedIn() && changed.hasOnly(['upvotes']) && (
        (newVotes == currentVotes + 1 && !exists(votePath) && existsAfter(votePath)) ||
        (newVotes == currentVotes - 1 && exists(votePath) && !existsAfter(votePath))
      );
    }

    function validSeedlingCounterUpdate(caseId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let followUpId = request.resource.data.get('lastSeedlingFollowUpId', '');
      let followUpPath = /databases/$(database)/documents/case_documentation/$(caseId)/seedling_followups/$(followUpId);
      let oldCount = resource.data.get('seedlingsPlanted', 0);
      let newCount = request.resource.data.get('seedlingsPlanted', 0);
      return isInspectionOfficer() &&
        resource.data.get('inspectorId', '') == request.auth.uid &&
        resource.data.get('status', '') == 'submitted' &&
        changed.hasOnly(['seedlingsPlanted', 'lastSeedlingFollowUpId', 'updatedAt']) &&
        followUpId is string && followUpId.size() > 0 &&
        newCount is int && newCount > oldCount &&
        newCount <= resource.data.get('seedlingsRequired', 0) &&
        existsAfter(followUpPath) &&
        getAfter(followUpPath).data.get('caseId', '') == caseId &&
        getAfter(followUpPath).data.get('inspectorId', '') == request.auth.uid &&
        getAfter(followUpPath).data.get('seedlingsPlanted', 0) == newCount - oldCount;
    }

    function validSeedlingFollowUpCreate(caseId, followUpId, data) {
      let parentPath = /databases/$(database)/documents/case_documentation/$(caseId);
      let parentBefore = get(parentPath).data;
      let parentAfter = getAfter(parentPath).data;
      let previousCount = parentBefore.get('seedlingsPlanted', 0);
      let nextCount = parentAfter.get('seedlingsPlanted', 0);
      return isInspectionOfficer() &&
        parentBefore.get('inspectorId', '') == request.auth.uid &&
        parentBefore.get('caseType', '') == 'tree_cutting_inspection' &&
        parentBefore.get('status', '') == 'submitted' &&
        data.get('inspectorId', '') == request.auth.uid &&
        data.get('seedlingsPlanted', 0) is int &&
        data.get('seedlingsPlanted', 0) > 0 &&
        data.get('visitDate', null) is timestamp &&
        nextCount == previousCount + data.get('seedlingsPlanted', 0) &&
        nextCount <= parentBefore.get('seedlingsRequired', 0) &&
        parentAfter.get('lastSeedlingFollowUpId', '') == followUpId;
    }

    match /feed/{feedId} {
      allow get, list: if signedIn();
      allow create, delete: if isAdmin() || isReceivingClerk() || isDenrOfficer();
      allow update: if isAdmin() || isReceivingClerk() || isDenrOfficer() ||
        validFeedCounterUpdate(feedId);

      match /comments/{commentId} {
        allow get, list: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['authorName', 'message', 'postedAt']) &&
          request.resource.data.get('message', '').size() > 0 &&
          request.resource.data.get('message', '').size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    function validFeedCounterUpdate(feedId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldLikes = resource.data.get('likeCount', 0);
      let newLikes = request.resource.data.get('likeCount', 0);
      let oldComments = resource.data.get('commentCount', 0);
      let newComments = request.resource.data.get('commentCount', 0);
      let userLikePath = /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(feedId);
      let reportId = resource.data.get('relatedId', '');
      return signedIn() && (
        (changed.hasOnly(['likeCount']) && (
          (newLikes == oldLikes + 1 && !exists(userLikePath) && existsAfter(userLikePath)) ||
          (newLikes == oldLikes - 1 && exists(userLikePath) && !existsAfter(userLikePath)) ||
          (reportId is string && reportId.size() > 0 && (
            (newLikes == oldLikes + 1 &&
              !exists(/databases/$(database)/documents/reports/$(reportId)/upvotes/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/reports/$(reportId)/upvotes/$(request.auth.uid))) ||
            (newLikes == oldLikes - 1 &&
              exists(/databases/$(database)/documents/reports/$(reportId)/upvotes/$(request.auth.uid)) &&
              !existsAfter(/databases/$(database)/documents/reports/$(reportId)/upvotes/$(request.auth.uid)))
          ))
        )) ||
        (changed.hasOnly(['commentCount']) && newComments == oldComments + 1)
      );
    }

    match /projects/{projectId} {
      allow get, list: if signedIn();
      allow create: if signedIn() && (
        isStaff() || request.resource.data.get('createdBy', '') == request.auth.uid
      );
      allow update: if isStaff() || validProjectParticipationUpdate();
      allow delete: if isAdmin();
    }

    function validProjectParticipationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldParticipants = resource.data.get('participants', []);
      let newParticipants = request.resource.data.get('participants', []);
      let oldCount = resource.data.get('participantCount', 0);
      let newCount = request.resource.data.get('participantCount', 0);
      return signedIn() && changed.hasOnly(['participants', 'participantCount']) && (
        (newParticipants.size() == oldParticipants.size() + 1 &&
          newParticipants.hasAll(oldParticipants) &&
          newParticipants.hasAny([request.auth.uid]) &&
          !oldParticipants.hasAny([request.auth.uid]) &&
          newCount == oldCount + 1) ||
        (oldParticipants.size() == newParticipants.size() + 1 &&
          oldParticipants.hasAll(newParticipants) &&
          oldParticipants.hasAny([request.auth.uid]) &&
          !newParticipants.hasAny([request.auth.uid]) &&
          newCount == oldCount - 1)
      );
    }

    match /case_documentation/{caseId} {
      allow get, list: if isAdmin() || (
        isInspectionOfficer() && resource.data.get('inspectorId', '') == request.auth.uid
      ) || (
        isDenrOfficer() &&
        resource.data.get('status', '') == 'forwarded_to_denr_officer'
      );
      allow create: if isInspectionOfficer() &&
        request.resource.data.keys().hasOnly([
          'caseType', 'title', 'findings', 'severity', 'urgency', 'siteAddress',
          'barangay', 'latitude', 'longitude', 'locationAccuracy', 'photos',
          'files', 'linkedApplicationId', 'linkedApplicationCollection',
          'inspectorId', 'inspectorName', 'status', 'recordedAt', 'createdAt',
          'updatedAt', 'checklistResponses', 'officerAttested',
          'officerAttestation', 'attestedAt', 'visitScheduledAt', 'treeCount',
          'treeActionType', 'seedlingsRequired', 'seedlingsPlanted', 'activityHistory'
        ]) &&
        request.resource.data.get('inspectorId', '') == request.auth.uid &&
        request.resource.data.get('caseType', '') in [
          'environmental_report', 'tree_cutting_inspection'
        ] &&
        request.resource.data.get('status', '') in ['draft', 'submitted'] &&
        request.resource.data.get('severity', 0) is int &&
        request.resource.data.severity >= 1 && request.resource.data.severity <= 5 &&
        request.resource.data.get('urgency', '') in ['normal', 'urgent', 'critical'] &&
        request.resource.data.get('title', '').size() > 0 &&
        request.resource.data.get('findings', '').size() > 0 &&
        request.resource.data.get('photos', []) is list &&
        request.resource.data.get('files', []) is list &&
        request.resource.data.get('checklistResponses', {}) is map &&
        request.resource.data.get('officerAttested', false) is bool &&
        request.resource.data.get('officerAttestation', '').size() <= 300 &&
        request.resource.data.get('treeCount', 0) is int &&
        request.resource.data.get('treeCount', 0) >= 0 &&
        request.resource.data.get('treeActionType', 'cutting') in ['cutting', 'trimming'] &&
        request.resource.data.get('seedlingsRequired', 0) ==
          (request.resource.data.get('treeActionType', 'cutting') == 'cutting'
            ? request.resource.data.get('treeCount', 0) * 3
            : 0) &&
        request.resource.data.get('activityHistory', []) is list &&
        request.resource.data.get('recordedAt', null) is timestamp &&
        request.resource.data.get('seedlingsPlanted', 0) == 0 &&
        (request.resource.data.get('status', '') != 'submitted' || (
          request.resource.data.get('officerAttested', false) == true &&
          request.resource.data.get('officerAttestation', '').size() > 0 &&
          request.resource.data.get('attestedAt', null) is timestamp
        ));
      allow update: if isAdmin() || validSeedlingCounterUpdate(caseId) ||
        inspectionCaseForwardUpdate() || (isInspectionOfficer() &&
        resource.data.get('inspectorId', '') == request.auth.uid &&
        resource.data.get('status', '') == 'draft' &&
        request.resource.data.get('inspectorId', '') == request.auth.uid &&
        request.resource.data.get('caseType', '') in [
          'environmental_report', 'tree_cutting_inspection'
        ] &&
        request.resource.data.get('status', '') in ['draft', 'submitted'] &&
        request.resource.data.keys().hasOnly([
          'caseType', 'title', 'findings', 'severity', 'urgency', 'siteAddress',
          'barangay', 'latitude', 'longitude', 'locationAccuracy', 'photos',
          'files', 'linkedApplicationId', 'linkedApplicationCollection',
          'inspectorId', 'inspectorName', 'status', 'recordedAt', 'createdAt',
          'updatedAt', 'checklistResponses', 'officerAttested',
          'officerAttestation', 'attestedAt', 'visitScheduledAt', 'treeCount',
          'treeActionType', 'seedlingsRequired', 'seedlingsPlanted', 'activityHistory'
        ]) &&
        request.resource.data.get('severity', 0) is int &&
        request.resource.data.get('severity', 0) >= 1 &&
        request.resource.data.get('severity', 0) <= 5 &&
        request.resource.data.get('urgency', '') in ['normal', 'urgent', 'critical'] &&
        request.resource.data.get('title', '').size() > 0 &&
        request.resource.data.get('findings', '').size() > 0 &&
        request.resource.data.get('photos', []) is list &&
        request.resource.data.get('files', []) is list &&
        request.resource.data.get('checklistResponses', {}) is map &&
        request.resource.data.get('officerAttested', false) is bool &&
        request.resource.data.get('officerAttestation', '').size() <= 300 &&
        (!request.resource.data.keys().hasAny(['visitScheduledAt']) ||
          request.resource.data.visitScheduledAt == null ||
          request.resource.data.visitScheduledAt is timestamp) &&
        request.resource.data.get('activityHistory', []) is list &&
        request.resource.data.get('treeCount', 0) is int &&
        request.resource.data.get('treeCount', 0) >= 0 &&
        request.resource.data.get('seedlingsPlanted', 0) ==
          resource.data.get('seedlingsPlanted', 0) &&
        request.resource.data.get('treeActionType', 'cutting') in ['cutting', 'trimming'] &&
        request.resource.data.get('seedlingsRequired', 0) ==
          (request.resource.data.get('treeActionType', 'cutting') == 'cutting'
            ? request.resource.data.get('treeCount', 0) * 3
            : 0) &&
        (request.resource.data.get('status', '') != 'submitted' || (
          request.resource.data.get('officerAttested', false) == true &&
          request.resource.data.get('officerAttestation', '').size() > 0 &&
          request.resource.data.get('attestedAt', null) is timestamp
        )));
      allow delete: if isAdmin();

      match /seedling_followups/{followUpId} {
        allow get, list: if isAdmin() || (
          isInspectionOfficer() &&
          get(/databases/$(database)/documents/case_documentation/$(caseId)).data.get('inspectorId', '') == request.auth.uid
        );
        allow create: if validSeedlingFollowUpCreate(
          caseId, followUpId, request.resource.data
        ) && request.resource.data.get('notes', '').size() <= 1000 &&
          request.resource.data.keys().hasOnly([
            'caseId', 'caseTitle', 'inspectorId', 'inspectorName',
            'seedlingsPlanted', 'visitDate', 'notes', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }

    match /inspection_tree_identifications/{identificationId} {
      allow get, list: if isAdmin() || (
        isInspectionOfficer() && resource.data.get('inspectorId', '') == request.auth.uid
      );
      allow create: if isInspectionOfficer() &&
        request.resource.data.keys().hasOnly([
          'inspectorId', 'inspectorName', 'source', 'identifiedAt',
          'suggestedScientificName', 'suggestedCommonNames',
          'matchedDropdownLabel', 'confidence', 'userAccepted',
          'speciesIdentification', 'evidencePhotoUrls', 'linkedApplicationId',
          'linkedApplicationCollection', 'latitude', 'longitude',
          'locationAccuracy', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.get('inspectorId', '') == request.auth.uid &&
        request.resource.data.get('source', '') == 'inspection_officer' &&
        request.resource.data.get('confidence', -1) is number &&
        request.resource.data.confidence >= 0 && request.resource.data.confidence <= 1 &&
        request.resource.data.get('userAccepted', false) == true &&
        request.resource.data.get('evidencePhotoUrls', []) is list &&
        request.resource.data.get('identifiedAt', '') is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'userId', 'title', 'body', 'type', 'timestamp', 'isRead',
          'relatedId', 'relatedCollection'
        ]) &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('isRead', true) == false &&
        request.resource.data.get('type', '') in [
          'reportUpdate', 'projectUpdate', 'comment', 'mention', 'system', 'badgeEarned'
        ];
      allow update: if signedIn() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.get('isRead', false) is bool;
      allow delete: if isAdmin();
    }

    match /audit_logs/{auditId} {
      allow get, list: if isAdmin();
      allow create: if isStaff() &&
        request.resource.data.get('adminUid', '') == request.auth.uid &&
        request.resource.data.get('action', '').size() > 0 &&
        request.resource.data.keys().hasOnly([
          'adminUid', 'adminName', 'adminEmail', 'action', 'targetType',
          'targetId', 'targetName', 'targetEmail', 'details', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /email_outbox/{emailId} {
      allow create: if isStaff() &&
        request.resource.data.keys().hasOnly([
          'to', 'subject', 'body', 'status', 'templateType', 'relatedType',
          'relatedId', 'recipientName', 'inspectionDate', 'applicationType',
          'sourceCollection', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('relatedType', '') == 'application' &&
        request.resource.data.get('sourceCollection', '') in [
          'applications', 'tree_cutting_permits'
        ] && request.resource.data.get('relatedId', '').size() > 0 &&
        request.resource.data.get('to', '').size() > 3 &&
        request.resource.data.get('subject', '').size() > 0 &&
        request.resource.data.get('body', '').size() > 0 &&
        get(/databases/$(database)/documents/$(request.resource.data.sourceCollection)/$(request.resource.data.relatedId)).data.get('applicantEmail',
          get(/databases/$(database)/documents/$(request.resource.data.sourceCollection)/$(request.resource.data.relatedId)).data.get('email', '')) == request.resource.data.to;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /services_transactions/{transactionId} {
      allow get, list: if isStaff() ||
        resource.data.get('applicantUid', '') == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.get('applicantUid', '') == request.auth.uid &&
        request.resource.data.get('status', '') == 'Pending Verification' &&
        request.resource.data.get('severity', null) == null &&
        request.resource.data.get('severityDeterminedBy', null) == null;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /charter_matrix/{serviceId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
